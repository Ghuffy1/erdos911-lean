import Erdos911.ConditionalLocalLemma
import Mathlib.MeasureTheory.Constructions.Pi

open MeasureTheory ProbabilityTheory

namespace Erdos911

def DependsOnlyOn {ι : Type*} {β : ι → Type*}
    (A : Set (∀ i, β i)) (S : Finset ι) : Prop :=
  ∀ ω ω', (∀ i ∈ S, ω i = ω' i) → ω ∈ A → ω' ∈ A

theorem DependsOnlyOn.mono {ι : Type*} {β : ι → Type*}
    {A : Set (∀ i, β i)} {S T : Finset ι}
    (h : DependsOnlyOn A S) (hST : S ⊆ T) : DependsOnlyOn A T :=
  fun ω ω' heq => h ω ω' (fun i hi => heq i (hST hi))

theorem DependsOnlyOn.measurable_comap {ι : Type*} {β : ι → Type*}
    [∀ i, Fintype (β i)] [∀ i, MeasurableSpace (β i)]
    [∀ i, MeasurableSingletonClass (β i)]
    {A : Set (∀ i, β i)} {S : Finset ι} (h : DependsOnlyOn A S) :
    MeasurableSet[MeasurableSpace.comap (fun ω (i : S) => ω i) MeasurableSpace.pi] A := by
  classical
  refine ⟨(fun ω (i : S) => ω i) '' A, (Set.toFinite _).measurableSet, ?_⟩
  ext ω
  simp only [Set.mem_preimage, Set.mem_image]
  constructor
  · rintro ⟨ω', hω', heq⟩
    exact h ω' ω (fun i hi => congrFun heq ⟨i, hi⟩) hω'
  · intro hω
    exact ⟨ω, hω, rfl⟩

theorem product_coordinate_independence {ι : Type*} [Fintype ι] [DecidableEq ι]
    {β : ι → Type*} [∀ i, MeasurableSpace (β i)]
    (μ : ∀ i, Measure (β i)) [∀ i, IsProbabilityMeasure (μ i)] (S : Finset ι) :
    Indep (MeasurableSpace.comap (fun ω (i : S) => ω i) MeasurableSpace.pi)
      (MeasurableSpace.comap (fun ω (i : (Sᶜ : Finset ι)) => ω i) MeasurableSpace.pi)
      (Measure.pi μ) := by
  have h : iIndepFun (fun i (ω : ∀ i, β i) => ω i) (Measure.pi μ) :=
    iIndepFun_pi (X := fun _ => id) (fun _ => aemeasurable_id)
  have hpair := h.indepFun_finset S Sᶜ disjoint_compl_right
    (fun i => measurable_pi_apply i)
  exact (IndepFun_iff_Indep _ _ _).mp hpair

/-- A coordinate event is independent of the joint sigma-algebra generated by
any family whose coordinate supports avoid its own support. -/
theorem independent_of_disjoint_coordinate_events {ι κ : Type*}
    [Fintype ι] [DecidableEq ι] {β : ι → Type*}
    [∀ i, Fintype (β i)] [∀ i, MeasurableSpace (β i)]
    [∀ i, MeasurableSingletonClass (β i)]
    (μ : ∀ i, Measure (β i)) [∀ i, IsProbabilityMeasure (μ i)]
    (A : κ → Set (∀ i, β i)) (D : κ → Finset ι)
    (hA : ∀ j, DependsOnlyOn (A j) (D j))
    (B : Set (∀ i, β i)) (S : Finset ι) (hB : DependsOnlyOn B S)
    (J : Set κ) (hdis : ∀ j ∈ J, Disjoint S (D j)) :
    Indep (MeasurableSpace.generateFrom {B})
      (MeasurableSpace.generateFrom {s | ∃ j ∈ J, s = A j}) (Measure.pi μ) := by
  refine indep_of_indep_of_le_right
    (indep_of_indep_of_le_left (product_coordinate_independence μ S) ?_) ?_
  · apply MeasurableSpace.generateFrom_le
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst t
    exact hB.measurable_comap
  · apply MeasurableSpace.generateFrom_le
    intro t ht
    obtain ⟨j, hj, rfl⟩ := ht
    apply ((hA j).mono ?_).measurable_comap
    intro i hi
    rw [Finset.mem_compl]
    exact fun hiS => Finset.disjoint_left.mp (hdis j hj) hiS hi

theorem product_dependency_graph {ι : Type*} [Fintype ι] [DecidableEq ι]
    {β : ι → Type*} [∀ i, Fintype (β i)] [∀ i, MeasurableSpace (β i)]
    [∀ i, MeasurableSingletonClass (β i)]
    (μ : ∀ i, Measure (β i)) [∀ i, IsProbabilityMeasure (μ i)] {n : ℕ}
    (A : Fin n → Set (∀ i, β i)) (D : Fin n → Finset ι)
    (hA : ∀ j, DependsOnlyOn (A j) (D j)) (Γ : SimpleGraph (Fin n))
    (hΓ : ∀ i j, j ≠ i → ¬Γ.Adj i j → Disjoint (D i) (D j)) :
    LocalLemma.IsDependencyGraph (Measure.pi μ) A Γ := by
  intro i
  simpa only [Set.mem_ofPred_eq, and_assoc] using
    independent_of_disjoint_coordinate_events μ A D hA (A i) (D i) (hA i)
    {j | j ≠ i ∧ ¬Γ.Adj i j} (fun j hj => hΓ i j hj.1 hj.2)

/-- The total weight of events touching a coordinate set is bounded by the
sum of the event weights at those coordinates. Repeated incidences increase
the latter sum and cause no loss in this inequality. -/
theorem touching_weight_sum_le {ι κ : Type*} [Fintype κ] [DecidableEq ι]
    (S : Finset ι) (D : κ → Finset ι) (x : κ → ℝ) (q : ℝ)
    (hx : ∀ j, 0 ≤ x j)
    (hq : ∀ i ∈ S, ∑ j ∈ Finset.univ.filter (fun j => i ∈ D j), x j ≤ q) :
    ∑ j ∈ Finset.univ.filter (fun j => ¬Disjoint S (D j)), x j ≤ q * S.card := by
  classical
  have hpoint : ∀ j : κ, (if ¬Disjoint S (D j) then x j else 0) ≤
      ∑ i ∈ S, if i ∈ D j then x j else 0 := by
    intro j
    by_cases hj : ¬Disjoint S (D j)
    · obtain ⟨i, hiS, hiD⟩ := Finset.not_disjoint_iff.mp hj
      simp only [ite_eq_left hj]
      have hnonneg : ∀ a ∈ S, 0 ≤ if a ∈ D j then x j else 0 := by
        intro a _
        split_ifs <;> simp_all
      simpa only [ite_eq_left hiD] using Finset.single_le_sum hnonneg hiS
    · simp only [ite_eq_right hj]
      exact Finset.sum_nonneg fun i _ => by split_ifs <;> simp_all
  calc
    (∑ j ∈ Finset.univ.filter (fun j => ¬Disjoint S (D j)), x j) =
        ∑ j : κ, if ¬Disjoint S (D j) then x j else 0 := by
      rw [Finset.sum_filter]
    _ ≤ ∑ j : κ, ∑ i ∈ S, if i ∈ D j then x j else 0 :=
      Finset.sum_le_sum (fun j _ => hpoint j)
    _ = ∑ i ∈ S, ∑ j ∈ Finset.univ.filter (fun j => i ∈ D j), x j := by
      rw [Finset.sum_comm]
      simp only [Finset.sum_filter]
    _ ≤ ∑ i ∈ S, q := Finset.sum_le_sum hq
    _ = q * S.card := by simp [mul_comm]

/-- Conditional probability bound for events determined by finitely many
independent coordinates, with a per-coordinate budget on local-lemma weights. -/
theorem conditional_lll_coordinates {ι : Type*} [Fintype ι] [DecidableEq ι]
    {β : ι → Type*} [∀ i, Fintype (β i)] [∀ i, MeasurableSpace (β i)]
    [∀ i, MeasurableSingletonClass (β i)]
    (μ : ∀ i, Measure (β i)) [∀ i, IsProbabilityMeasure (μ i)] {n : ℕ}
    (A : Fin n → Set (∀ i, β i)) (D : Fin n → Finset ι)
    (hA : ∀ j, DependsOnlyOn (A j) (D j))
    (Γ : SimpleGraph (Fin n)) [DecidableRel Γ.Adj]
    (hΓ : ∀ i j, j ≠ i → ¬Γ.Adj i j → Disjoint (D i) (D j))
    (x : Fin n → ℝ) (hx₀ : ∀ j, 0 ≤ x j) (hxhalf : ∀ j, x j ≤ 1 / 2)
    (hP : ∀ i, (Measure.pi μ).real (A i) ≤
      x i * ∏ j ∈ Γ.neighborFinset i, (1 - x j))
    (B : Set (∀ i, β i)) (S : Finset ι) (hB : DependsOnlyOn B S)
    (q : ℝ)
    (hq : ∀ i ∈ S, ∑ j ∈ Finset.univ.filter (fun j => i ∈ D j), x j ≤ q) :
    (Measure.pi μ).real (B ∩ LocalLemma.avoid A Finset.univ) /
        (Measure.pi μ).real (LocalLemma.avoid A Finset.univ) ≤
      (Measure.pi μ).real B * Real.exp (2 * (q * S.card)) := by
  classical
  let J : Finset (Fin n) := Finset.univ.filter fun j => ¬Disjoint S (D j)
  have hdis : ∀ j ∈ {j | j ∉ J}, Disjoint S (D j) := by
    intro j hj
    simpa [J] using hj
  have hBI : Indep (MeasurableSpace.generateFrom {B})
      (MeasurableSpace.generateFrom {s | ∃ j, j ∉ J ∧ s = A j}) (Measure.pi μ) := by
    simpa only [Set.mem_ofPred_eq] using
      independent_of_disjoint_coordinate_events μ A D hA B S hB {j | j ∉ J} hdis
  exact conditional_lll_exp (Measure.pi μ) A
    (fun j => (Set.toFinite (A j)).measurableSet) Γ
    (product_dependency_graph μ A D hA Γ hΓ) x hx₀ hxhalf hP B J (q * S.card) hBI
    (touching_weight_sum_le S D x q hx₀ hq)

end Erdos911
